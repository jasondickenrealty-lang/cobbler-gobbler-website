NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_API_BASE=https://us-central1-cobblestone-pos.cloudfunctions.net/api
JOB_APPLICATION_API_BASE=https://us-central1-cobblestone-pos.cloudfunctions.net/api

# ── Live Google reviews (server-side only — never prefix with NEXT_PUBLIC_) ──
# When both are set, the homepage reviews section shows REAL rating, review
# count, and recent reviews from your Google Business Profile. When unset, it
# falls back to a neutral "Read Our Google Reviews" call-to-action. No
# fabricated ratings or testimonials are ever shown.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACE_ID=your_google_business_place_id_here
