{
  "name": "cobblestone-creamery-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"const fs=require('fs');const p=require('path');const src=p.resolve(__dirname,'../shared');const dst=p.resolve(__dirname,'src/shared');if(fs.existsSync(src)){fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).forEach(f=>fs.copyFileSync(p.join(src,f),p.join(dst,f)))}\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:sms-compliance": "node ./scripts/verify-sms-compliance-asset.cjs",
    "check:prod": "npm run check:sms-compliance && next build",
    "deploy": "npm run check:prod && firebase deploy --only apphosting:website --project cobblestone-pos"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "firebase": "^10.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0"
  }
}
